BOT_TOKEN=
OWNER_IDS=
# Use a unique password of at least 16 characters.
WEB_CONTROL_PASSWORD=
# Generate 32 random hexadecimal bytes, e.g. openssl rand -hex 32.
# Use hexadecimal here so it can be embedded safely in DATABASE_URL.
POSTGRES_PASSWORD=
# Optional: hostname only, without https:// or a path.
DOMAIN=
# Optional browser support requires rebuilding the image after changing this.
BROWSER_ENABLED=false
