+    r=Registry();r.load();a='https://gamerxyt.com/a';b='https://gamerxyt.com/b'
+    net=FakeNetwork({a:page(a,f'<a id="download" href="{b}">Next</a>'),b:page(b,f'<a id="download" href="{a}#again">Next</a>')})
